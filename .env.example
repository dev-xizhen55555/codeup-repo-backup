# 此文件展示了 OSS 中 codeupbackup.env 的配置模板
# 在生产环境中，这些配置必须存储在 OSS 对象存储中，而非环境变量

# Codeup 配置（必需）
CODEUP_TOKEN=your-codeup-token
CODEUP_ORG_ID=your-org-id

# GitLab 配置（可选，未配置则跳过 GitLab 备份）
GITLAB_TOKEN=your-gitlab-token
GITLAB_NAMESPACE_PATH=your-namespace-path
GITLAB_NAMESPACE_ID=your-namespace-id
GITLAB_API_BASE=https://gitlab.com/api/v4

# Gitee 配置（可选，未配置则跳过 Gitee 备份）
GITEE_TOKEN=your-gitee-token

# AtomGit 配置(可选, Token 为空则跳过, 仅存储在 OSS 配置文件中)
ATOMGIT_TOKEN=
ATOMGIT_API_BASE=https://api.atomgit.com/api/v5
# AtomGit 独立状态, Docker 生产环境使用 S3
S3_STATE_KEY_ATOMGIT=codeup-backup/state-atomgit.json
LOCAL_STATE_FILE_ATOMGIT=./.backup_state_atomgit.json

# 并发配置（可选）
CONCURRENCY=3

# 备份行为配置（可选）
FORCE_FULL=false
BACKUP_VISIBILITY=private
# AtomGit 固定私有, 不受 BACKUP_VISIBILITY 影响
